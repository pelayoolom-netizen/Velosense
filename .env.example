# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
GEMINI_API_KEY="AIzaSy_placeholder"

# GOOGLE SIGN-IN CREDENTIAL MANAGER:
# Web Client ID from Google Cloud Console (OAuth 2.0 Client IDs -> Web application).
# Needed by Android Credential Manager GetGoogleIdOption.
GOOGLE_SERVER_CLIENT_ID="placeholder_google_client_id"

# STRAVA OAUTH 2.0:
# From Strava Developer Portal (https://www.strava.com/settings/api).
# Authorization Callback Domain must be configured as: strava-callback
STRAVA_CLIENT_ID="placeholder_strava_client_id"
STRAVA_CLIENT_SECRET="placeholder_strava_client_secret"


